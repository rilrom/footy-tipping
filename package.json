{
  "name": "footy-tipping",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "concurrently \"pnpm run server\" \"vite\"",
    "server": "tsx server/index.ts",
